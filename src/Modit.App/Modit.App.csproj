<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(ModitTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(ModitMinOs)</TargetPlatformMinVersion>
    <RootNamespace>Modit.App</RootNamespace>
    <AssemblyName>Modit.App</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Unpackaged, fully self-contained: runs on a clean machine with nothing preinstalled (docs/plan/14). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>$(ModitRid)</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- The engine host is only launched as a process, never loaded; release builds publish it self-contained (tools/build.ps1). -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\modit.ico</ApplicationIcon>
    <!-- Program.Main must run the Velopack hooks before any XAML code. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <DefaultLanguage>en-US</DefaultLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <!-- Microsoft.VisualStudio.Threading references WindowsBase (WPF) for an optional path Modit never takes;
         the desktop framework is deliberately not shipped (see Directory.Build.props). -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Velopack" />
    <ProjectReference Include="..\Modit.App.ViewModels\Modit.App.ViewModels.csproj" />
    <ProjectReference Include="..\Modit.Core\Modit.Core.csproj" />
    <ProjectReference Include="..\Modit.Update\Modit.Update.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\modit.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\modit-256.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="$(RepoRoot)build\EngineHost.targets" />
</Project>
