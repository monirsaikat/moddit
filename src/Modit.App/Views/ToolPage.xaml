<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Modit.App.Views.ToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Modit.App.Views"
    xmlns:vm="using:Modit.App.ViewModels">

    <ScrollViewer Background="{ThemeResource LayerFillColorDefaultBrush}">
        <StackPanel
            MaxWidth="760"
            Padding="24,24,24,48"
            Spacing="8">

            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title}" />
            <TextBlock
                Margin="0,0,0,12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Description}"
                TextWrapping="Wrap" />

            <!-- 1. Files -->
            <TextBlock
                x:Uid="ToolFilesHeader"
                Margin="0,8,0,4"
                Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Uid="ToolFilesEmpty"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:ToolPage.Not(ViewModel.HasFiles), Mode=OneWay}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Files}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ToolInputFile">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="20"
                                        Glyph="&#xEA90;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Folder}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <TextBox
                                        x:Uid="ToolFilePages"
                                        Grid.Column="2"
                                        Width="150"
                                        VerticalAlignment="Center"
                                        Loaded="OnPerFilePagesLoaded"
                                        Text="{x:Bind Pages, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="2">
                                        <Button
                                            x:Uid="ToolFileUp"
                                            Padding="8,6"
                                            Click="OnMoveUpClick"
                                            Loaded="OnReorderButtonLoaded">
                                            <FontIcon FontSize="12" Glyph="&#xE70E;" />
                                        </Button>
                                        <Button
                                            x:Uid="ToolFileDown"
                                            Padding="8,6"
                                            Click="OnMoveDownClick"
                                            Loaded="OnReorderButtonLoaded">
                                            <FontIcon FontSize="12" Glyph="&#xE70D;" />
                                        </Button>
                                        <Button
                                            x:Uid="ToolFileRemove"
                                            Padding="8,6"
                                            Click="OnRemoveClick">
                                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Button
                        x:Uid="ToolAddFiles"
                        Click="OnAddFilesClick"
                        IsEnabled="{x:Bind ViewModel.CanAddFiles, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- 2. Options -->
            <TextBlock
                x:Uid="ToolOptionsHeader"
                Margin="0,16,0,4"
                Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="16">
                    <TextBox
                        x:Uid="ToolPages"
                        Text="{x:Bind ViewModel.PagesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind ViewModel.ShowPages}" />

                    <NumberBox
                        x:Uid="ToolPagesPerFile"
                        HorizontalAlignment="Left"
                        Minimum="1"
                        SpinButtonPlacementMode="Inline"
                        Visibility="{x:Bind ViewModel.ShowPagesPerFile}"
                        Value="{x:Bind ViewModel.PagesPerFile, Mode=TwoWay}" />

                    <ComboBox
                        x:Uid="ToolAngle"
                        MinWidth="260"
                        SelectedIndex="{x:Bind ViewModel.AngleIndex, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.ShowAngle}">
                        <ComboBoxItem x:Uid="ToolAngle90" />
                        <ComboBoxItem x:Uid="ToolAngle180" />
                        <ComboBoxItem x:Uid="ToolAngle270" />
                    </ComboBox>

                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowProtection}">
                        <PasswordBox x:Uid="ToolUserPassword" Password="{x:Bind ViewModel.UserPassword, Mode=TwoWay}" />
                        <PasswordBox x:Uid="ToolOwnerPassword" Password="{x:Bind ViewModel.OwnerPassword, Mode=TwoWay}" />
                        <CheckBox x:Uid="ToolAllowPrinting" IsChecked="{x:Bind ViewModel.AllowPrinting, Mode=TwoWay}" />
                        <CheckBox x:Uid="ToolAllowCopying" IsChecked="{x:Bind ViewModel.AllowCopying, Mode=TwoWay}" />
                        <CheckBox x:Uid="ToolAllowEditing" IsChecked="{x:Bind ViewModel.AllowEditing, Mode=TwoWay}" />
                    </StackPanel>

                    <CheckBox
                        x:Uid="ToolFastWebView"
                        IsChecked="{x:Bind ViewModel.FastWebView, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.ShowFastWebView}" />

                    <NumberBox
                        x:Uid="ToolDpi"
                        HorizontalAlignment="Left"
                        Maximum="1200"
                        Minimum="8"
                        SpinButtonPlacementMode="Inline"
                        Visibility="{x:Bind ViewModel.ShowDpi}"
                        Value="{x:Bind ViewModel.Dpi, Mode=TwoWay}" />

                    <PasswordBox x:Uid="ToolInputPassword" Password="{x:Bind ViewModel.InputPassword, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- 3. Destination -->
            <TextBlock
                x:Uid="ToolOutputHeader"
                Margin="0,16,0,4"
                Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Uid="ToolOutputPath" Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            x:Uid="ToolBrowse"
                            Grid.Column="1"
                            Click="OnBrowseClick" />
                    </Grid>
                    <CheckBox x:Uid="ToolOverwrite" IsChecked="{x:Bind ViewModel.Overwrite, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Run -->
            <StackPanel
                Margin="0,16,0,0"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    MinWidth="120"
                    Command="{x:Bind ViewModel.RunCommand}"
                    Content="{x:Bind ViewModel.Title}"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button
                    x:Uid="CancelButtonControl"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
            </StackPanel>
            <ProgressBar
                x:Name="RunProgress"
                Margin="0,4,0,0"
                Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />

            <InfoBar
                x:Name="ResultBar"
                Margin="0,8,0,0"
                IsClosable="True">
                <InfoBar.ActionButton>
                    <Button
                        x:Name="ResultOpenButton"
                        x:Uid="ToolResultOpen"
                        Click="OnOpenResultClick" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
    </ScrollViewer>
</Page>
