<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Modit.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Background="{ThemeResource LayerFillColorDefaultBrush}">
        <StackPanel
            MaxWidth="760"
            Padding="24,24,24,48"
            HorizontalAlignment="Stretch"
            Spacing="8">

            <TextBlock
                x:Uid="SettingsTitle"
                Margin="0,0,0,12"
                Style="{ThemeResource TitleTextBlockStyle}" />

            <!-- Appearance -->
            <TextBlock
                x:Uid="SettingsAppearanceHeader"
                Margin="0,8,0,4"
                Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Uid="SettingsThemeLabel" />
                        <TextBlock
                            x:Uid="SettingsThemeDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Uid="SettingsThemeComboBox"
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem x:Uid="ThemeSystem" />
                        <ComboBoxItem x:Uid="ThemeLight" />
                        <ComboBoxItem x:Uid="ThemeDark" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Updates -->
            <TextBlock
                x:Uid="SettingsUpdatesHeader"
                Margin="0,16,0,4"
                Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Uid="SettingsVersionLabel" />
                                <TextBlock
                                    x:Name="VersionText"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.CurrentVersion, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ProgressRing
                                Width="20"
                                Height="20"
                                IsActive="{x:Bind ViewModel.IsUpdateBusy, Mode=OneWay}" />
                            <Button
                                x:Uid="SettingsRestartButton"
                                Command="{x:Bind ViewModel.RestartToUpdateCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                Visibility="{x:Bind ViewModel.IsRestartAvailable, Mode=OneWay}" />
                            <Button
                                x:Uid="SettingsCheckButton"
                                Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                IsEnabled="{x:Bind ViewModel.UpdatesAvailableInThisCopy, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Height="1"
                        Margin="-16,0"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Uid="SettingsChannelLabel" />
                            <TextBlock
                                x:Uid="SettingsChannelDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            x:Uid="SettingsChannelComboBox"
                            Grid.Column="1"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind ViewModel.IsUpdateChannelEditable, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.UpdateChannelIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="ChannelStable" />
                            <ComboBoxItem x:Uid="ChannelBeta" />
                        </ComboBox>
                    </Grid>

                    <ToggleSwitch
                        x:Uid="SettingsAutoCheckToggle"
                        IsEnabled="{x:Bind ViewModel.UpdatesAvailableInThisCopy, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.CheckAutomatically, Mode=TwoWay}" />
                    <ToggleSwitch
                        x:Uid="SettingsInstallOnExitToggle"
                        IsEnabled="{x:Bind ViewModel.UpdatesAvailableInThisCopy, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.InstallOnExit, Mode=TwoWay}" />

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="{x:Bind ViewModel.AreUpdatesManaged}">
                        <FontIcon FontSize="12" Glyph="&#xE72E;" />
                        <TextBlock x:Uid="ManagedByOrganization" Style="{ThemeResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <TextBlock
                x:Uid="SettingsAboutHeader"
                Margin="0,16,0,4"
                Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel>
                        <TextBlock x:Uid="SettingsUpdateFeedLabel" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.UpdateFeed}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Uid="SettingsDataFolderLabel" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.DataFolder}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="{x:Bind ViewModel.IsPortable}">
                        <FontIcon FontSize="12" Glyph="&#xE88E;" />
                        <TextBlock x:Uid="PortableModeLabel" Style="{ThemeResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <Button x:Uid="SettingsOpenLogsButton" Click="OnOpenLogsClick" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
